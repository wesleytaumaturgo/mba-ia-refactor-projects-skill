# Copie para .env e preencha. O arquivo .env é ignorado pelo VCS.
# A aplicação FALHA NO BOOT se LOJA_SECRET_KEY estiver ausente.

# Obrigatória — chave de assinatura das credenciais emitidas no login.
LOJA_SECRET_KEY=

# Ambiente: development | production
LOJA_ENV=development

# Persistência
LOJA_DB_PATH=loja.db

# Servidor. Em produção, mantenha LOJA_DEBUG=false e evite bind em 0.0.0.0.
LOJA_HOST=127.0.0.1
LOJA_PORT=5000
LOJA_DEBUG=false

# Observabilidade
LOJA_LOG_LEVEL=INFO

# Política de origem cruzada — lista separada por vírgula. Vazio = nenhuma origem liberada.
LOJA_ALLOWED_ORIGINS=

# Autenticação
LOJA_TOKEN_TTL_SECONDS=3600
LOJA_PASSWORD_COST_LOG2=14
LOJA_LOGIN_RATE_LIMIT=5
LOJA_LOGIN_RATE_WINDOW_SECONDS=300

# Paginação
LOJA_PAGE_SIZE_DEFAULT=20
LOJA_PAGE_SIZE_MAX=100

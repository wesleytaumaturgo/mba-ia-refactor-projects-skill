# Copie para .env e preencha. O .env real NÃO vai para o controle de versão.

# development | production
APP_ENV=development

# Obrigatória em produção — o boot falha sem ela.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DEBUG=true
HOST=127.0.0.1
PORT=5000

DATABASE_URI=sqlite:///tasks.db

# Autenticação
TOKEN_TTL_SECONDS=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
PASSWORD_HASH_ITERATIONS=260000

# Paginação
PAGE_SIZE_DEFAULT=50
PAGE_SIZE_MAX=200

# Origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# SMTP — sem valores reais aqui
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

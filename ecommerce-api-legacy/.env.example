# Copie para .env e preencha. O .env real está ignorado pelo VCS.
# A aplicação FALHA NO BOOT, nomeando a chave, se uma obrigatória estiver ausente.

# ── Obrigatórias ─────────────────────────────────────────────────────────────
# Chave do gateway de pagamento. NUNCA versione o valor real.
PAYMENT_GATEWAY_KEY=
# Token do operador administrativo, exigido pelas rotas privilegiadas.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ── Opcionais, com default ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Bind de rede. Default 127.0.0.1 — não exponha em todas as interfaces sem necessidade.
HOST=127.0.0.1
LOG_LEVEL=info
# Destino do banco. ':memory:' é volátil e só serve para desenvolvimento.
DATABASE_FILE=:memory:
# Fator de custo do scrypt (N). Maior = mais lento = mais seguro.
PASSWORD_COST_FACTOR=16384
# Limite de taxa da rota pública de checkout.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
